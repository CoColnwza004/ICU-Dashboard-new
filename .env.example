# URL ของ Google Apps Script Web App (ลงท้ายด้วย /exec) — ดูวิธีตั้งค่าใน README.md
# ถ้าไม่ใส่ ผู้ใช้สามารถวางลิงก์เองได้ที่หน้า "เชื่อมต่อ Google Sheet" ในเว็บ
VITE_SHEETS_API_URL=

# (ไม่บังคับ) รหัสลับต้องตรงกับ API_TOKEN ใน Apps Script
VITE_SHEETS_API_TOKEN=

# ความถี่ในการดึงข้อมูลจากชีต (มิลลิวินาที) ค่าเริ่มต้น 5000
VITE_POLL_MS=5000
